{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Insomnia Local",
  "version": "0.1.0",
  "identifier": "dev.insomnia.local",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Insomnia Local", "theme": "Dark", "width": 1440, "height": 960, "minWidth": 1000, "minHeight": 680 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "shortDescription": "Local-first API workspace without accounts",
    "category": "DeveloperTool",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
