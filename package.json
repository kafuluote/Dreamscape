{
  "name": "insomnia-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An account-free API desktop client rebuilt with Rust and Tauri",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "desktop:build": "tauri build",
    "tauri": "tauri",
    "type-check": "tsc --noEmit",
    "lint": "eslint src scripts tests && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test": "vitest run && node --test tests/plugin-runner.test.cjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run type-check && npm test && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
